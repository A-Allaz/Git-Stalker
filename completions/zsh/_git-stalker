_git-stalker() {
    if (( CURRENT >= 4 )) &&
        [[ ${words[CURRENT-2]} == --get-target &&
           ${words[CURRENT-1]} == [rFf] ]]; then
        _files
        return $?
    fi

    _arguments -s -S \
        '(-h --help)-h[Show help]' \
        '(-h --help)--help[Show help]' \
        '--clean-logs[Remove log files]' \
        '--verbose[Set log verbosity]:verbosity:(0 1 2)' \
        '--get-target[Select target mode]:target mode:(r F f)'\
        '--show-logs[Print latest logs]'
}

compdef _git-stalker git-stalker