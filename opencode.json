{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2048
  },
  "model": "llama.cpp/qwen2.5-coder-7b",
  "small_model": "google/gemini-3.5-flash-lite",
  "plugins": [
    {
      "package": "opencode-runtime-fallback",
      "options": {
        "fallback_models": [
          "google/gemini-3.8-flash",
          "google/gemini-3.5-flash-lite"
        ],
        "timeout_seconds": 15
      }
    }
  ],
  "providers": {
    "llama.cpp": {
      "name": "Local llama.cpp",
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen2.5-coder-7b": {
          "modelID": "qwen2.5-coder-7b",
          "name": "Qwen2.5-Coder 7B Q4_K_M",
          "limit": {
            "context": 8192,
            "output": 2048
          }
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "external_directory": "deny"
  }
}
